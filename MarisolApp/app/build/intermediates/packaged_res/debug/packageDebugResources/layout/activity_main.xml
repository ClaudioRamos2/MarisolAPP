<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1DC"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogoInicio"
        android:layout_width="290dp"
        android:layout_height="175dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Logo Papelería Marisol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/tvTituloInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-black"
        android:text="Papelería Marisol"
        android:textColor="#3D405B"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogoInicio" />

    <TextView
        android:id="@+id/tvSubtituloInicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="Catálogo Digital"
        android:textColor="#FF8500"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloInicio" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#FFFFFB"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloInicio">

        <TextView
            android:id="@+id/tvDescripcionNegocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:text="Tu aliado en útiles escolares, encuadernado, laminado, maquetas y trabajos secretariales. Además, contamos con maquillaje, juguetes y golosinas."            android:textColor="#3D405B"
            android:textSize="14sp" />
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnVerProductos"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#3D405B"
        android:text="CATÁLOGO DE PRODUCTOS"
        android:textColor="#FFFFFB"
        android:textSize="15sp"
        app:cornerRadius="20dp"
        app:icon="@drawable/caja"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="28dp"
        app:iconTint="#FFFFFB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDescripcion" />

    <Button
        android:id="@+id/btnVerServicios"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF8500"
        android:text="NUESTROS SERVICIOS"
        android:textColor="#FFFFFB"
        android:textSize="15sp"
        app:cornerRadius="20dp"
        app:icon="@drawable/impresora"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="28dp"
        app:iconTint="#FFFFFB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVerProductos" />

    <Button
        android:id="@+id/btnAccesoAdmin"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="28dp"
        android:text="ACCESO ADMINISTRATIVO"
        android:textColor="#3D405B"
        android:textSize="13sp"
        app:cornerRadius="20dp"
        app:icon="@drawable/user"
        app:iconGravity="textStart"
        app:iconSize="22dp"
        app:iconTint="#3D405B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#3D405B"
        app:strokeWidth="1.5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>