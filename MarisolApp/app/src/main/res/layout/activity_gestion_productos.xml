<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1DC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF1DC"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="32dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnVolverProductos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="?attr/homeAsUpIndicator"
                app:tint="#3D405B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Gestión de Productos"
                    android:textColor="#3D405B"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Papelería Marisol"
                    android:textColor="#FF8500"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta de formulario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFD2A6"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="#E5C9A8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText
                    android:id="@+id/etNombreProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFF1DC"
                    android:hint="Nombre del producto"
                    android:inputType="textCapWords"
                    android:padding="10dp"
                    android:textColor="#3D405B"
                    android:textColorHint="#7A7E99"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etCategoriaProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF1DC"
                    android:hint="Categoría (ej. Cuadernos, Escritura, Arte)"
                    android:inputType="textCapWords"
                    android:padding="10dp"
                    android:textColor="#3D405B"
                    android:textColorHint="#7A7E99"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPrecioProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="#FFF1DC"
                        android:hint="Precio (L.)"
                        android:inputType="numberDecimal"
                        android:padding="10dp"
                        android:textColor="#3D405B"
                        android:textColorHint="#7A7E99"
                        android:textSize="14sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swDisponible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Disponible"
                        android:textColor="#3D405B"
                        android:textSize="12sp"
                        app:thumbTint="#FF8500"
                        app:trackTint="#FFF1DC" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etImagenUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF1DC"
                    android:hint="URL de la imagen del producto"
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:textColor="#3D405B"
                    android:textColorHint="#7A7E99"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etDescripcionProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#FFF1DC"
                    android:gravity="top"
                    android:hint="Descripción breve del producto"
                    android:inputType="textMultiLine"
                    android:minLines="1"
                    android:padding="10dp"
                    android:textColor="#3D405B"
                    android:textColorHint="#7A7E99"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGuardarProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#FF8500"
                        android:text="Guardar"
                        android:textColor="#FFFFFB"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnLimpiarProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#3D405B"
                        android:text="Limpiar"
                        android:textColor="#FFFFFB" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Productos registrados • Toca para editar, mantén para eliminar"
            android:textColor="#3D405B"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGestionProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>